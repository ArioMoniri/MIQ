        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ (yükleniyor…)"
          }
        }
      }
    },
    "%@ is %@ in iCloud (not downloaded).\nLoading it now downloads the whole file, which could make Finder unresponsive." : {
      "comment" : "Deferred-preview placeholder; %1$@ is the file name, %2$@ its size.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ ist %2$@ groß und liegt in iCloud (nicht geladen).\nBeim Laden wird die ganze Datei heruntergeladen; der Finder reagiert dann möglicherweise nicht."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@, iCloud’da %2$@ boyutunda (indirilmemiş).\nŞimdi yüklemek tüm dosyayı indirir; bu da Finder’ın yanıt vermemesine yol açabilir."
          }
        }
      }
    },
    "%@ is %@ on a network volume.\nLoading it now could make Finder unresponsive while it transfers." : {
      "comment" : "Deferred-preview placeholder; %1$@ is the file name, %2$@ its size.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ ist %2$@ groß und liegt auf einem Netzwerkvolume.\nBeim Laden reagiert der Finder während der Übertragung möglicherweise nicht."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@, bir ağ biriminde %2$@ boyutunda.\nŞimdi yüklemek, aktarım sürerken Finder’ın yanıt vermemesine yol açabilir."
          }
        }
      }
    },
