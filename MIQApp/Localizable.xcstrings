    "Apple on-device model" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apples On-Device-Modell"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple’ın cihaz üstü modeli"
          }
        }
      }
    },
    "As Stored" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wie gespeichert"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kaydedildiği gibi"
          }
        }
      }
    },
    "As Stored shows voxels in file order, with edge labels for the anatomy. Neurological puts the patient’s right on the right of the screen; Radiological on the left." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„Wie gespeichert“ zeigt die Voxel in Dateireihenfolge, mit Randbeschriftungen für die Anatomie. Neurologisch zeigt die rechte Seite der Person rechts auf dem Bildschirm, Radiologisch links."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kaydedildiği gibi, vokselleri dosya sırasıyla ve anatomi için kenar etiketleriyle gösterir. Nörolojik, kişinin sağını ekranın sağına; Radyolojik soluna koyar."
          }
        }
      }
    },
    "Ask before loading large files on network volumes" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vor dem Laden großer Dateien auf Netzwerkvolumes fragen"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ağ birimlerindeki büyük dosyaları yüklemeden önce sor"
          }
        }
      }
    },
