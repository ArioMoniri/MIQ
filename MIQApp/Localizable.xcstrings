          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Önizlemede en yüksek ve en düşük yoğunluk projeksiyonları ile 3B görüntü sunar. Yalnızca siz seçtiğinizde hesaplanırlar."
          }
        }
      }
    },
    "Only local servers are allowed: use 127.0.0.1, localhost or [::1]." : {
