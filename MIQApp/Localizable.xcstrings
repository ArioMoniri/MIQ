    "Winter" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Winter"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Winter (kış)"
          }
        }
      }
    },
    "Writes a one-sentence technical description (likely modality, dimensions, resolution, coverage) using a model on this Mac. Only header facts are used — never the file name or free-text fields. Not a medical interpretation." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schreibt mit einem Modell auf diesem Mac eine technische Beschreibung in einem Satz (wahrscheinliche Modalität, Abmessungen, Auflösung, Abdeckung). Es werden nur Angaben aus dem Header verwendet — nie der Dateiname oder Freitextfelder. Keine medizinische Interpretation."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu Mac’teki bir modelle tek cümlelik teknik bir açıklama yazar (olası modalite, boyutlar, çözünürlük, kapsam). Yalnızca başlık bilgileri kullanılır — dosya adı veya serbest metin alanları asla kullanılmaz. Tıbbi bir yorum değildir."
          }
        }
      }
    },
    "You can also choose MIQ › Check for Updates… at any time." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sie können auch jederzeit MIQ › Nach Updates suchen… wählen."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "İstediğiniz zaman MIQ › Güncellemeleri Denetle… komutunu da seçebilirsiniz."
          }
        }
      }
    },
    "Zoom & pan" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zoomen & verschieben"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yakınlaştırma ve kaydırma"
          }
        }
      }
    },
    "Zooms around the pointer. Zoomed in, ⇧-drag, Space-drag or middle-drag pans; the wheel still changes slices. Press 0 to reset." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zoomt um den Zeiger. Vergrößert verschieben ⇧-Ziehen, Leertaste-Ziehen oder Ziehen mit der mittleren Taste die Ansicht; das Rad wechselt weiterhin die Schicht. Mit 0 zurücksetzen."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "İmlecin çevresinde yakınlaştırır. Yakınlaştırılmışken ⇧ ile, Boşluk ile veya orta tuşla sürükleme görünümü kaydırır; tekerlek yine kesit değiştirir. Sıfırlamak için 0’a basın."
          }
        }
      }
    },
