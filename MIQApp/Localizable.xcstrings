    "Every setting returns to its default, including automatic update checks. Settings managed by your organisation stay as they are." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alle Einstellungen kehren zu ihren Standardwerten zurück, einschließlich der automatischen Suche nach Updates. Von Ihrer Organisation verwaltete Einstellungen bleiben unverändert."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Otomatik güncelleme denetimi dahil tüm ayarlar varsayılana döner. Kuruluşunuzun yönettiği ayarlar olduğu gibi kalır."
          }
        }
      }
    },
