            "value" : "Netzwerkvolumes einbeziehen"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ağ birimlerini dahil et"
          }
        }
      }
    },
    "Initial CT window" : {
      "localizations" : {
