    "Select an image in Finder and press Space." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wählen Sie im Finder ein Bild aus und drücken Sie die Leertaste."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Finder’da bir görüntü seçip Boşluk tuşuna basın."
          }
        }
      }
    },
    "Selected acquisition parameters from a BIDS .json file next to the image, with a warning when they disagree with the header. Only where macOS lets the preview read the folder." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ausgewählte Aufnahmeparameter aus einer BIDS-.json-Datei neben dem Bild, mit einer Warnung, wenn sie dem Header widersprechen. Nur, wo macOS der Vorschau das Lesen des Ordners erlaubt."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Görüntünün yanındaki BIDS .json dosyasından seçilmiş çekim parametreleri; başlıkla uyuşmadıklarında uyarı ile. Yalnızca macOS önizlemenin klasörü okumasına izin verdiğinde."
          }
        }
      }
    },
