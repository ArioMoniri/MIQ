            "value" : "Önizlemelerde sorumluluk reddini gizle"
          }
        }
      }
    },
    "Hot" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hot (Wärme)"
          }
        },
