    },
    "Double-click again, or press Esc, to restore the four panels. On a zoomed panel the first double-click resets the zoom." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erneuter Doppelklick oder Esc stellt die vier Felder wieder her. In einem gezoomten Feld setzt der erste Doppelklick den Zoom zurück."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dört paneli geri getirmek için yeniden çift tıklayın veya Esc’ye basın. Yakınlaştırılmış bir panelde ilk çift tıklama yakınlaştırmayı sıfırlar."
          }
        }
      }
    },
    "Drag either end, or focus it and use the arrow keys." : {
      "localizations" : {
        "de" : {
