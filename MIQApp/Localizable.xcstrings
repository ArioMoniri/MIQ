{
  "sourceLanguage" : "en",
  "strings" : {
    "%@ (example)" : {
      "comment" : "Settings sample metadata: a made-up value shown only to illustrate a row",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ (Beispiel)"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ (örnek)"
          }
        }
      }
    },
    "%@ (not installed)" : {
      "comment" : "Open volumes in: a chosen app that is not installed; %@ is its bundle identifier",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ (nicht installiert)"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ (yüklü değil)"
          }
        }
      }
    },
    "%@ in Finder, with a slice thumbnail" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ im Finder, mit Schichtminiatur"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Finder’da %@, kesit küçük resmiyle"
          }
        }
      }
    },
    "%@ in Finder, with the standard document icon" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ im Finder, mit dem Standard-Dokumentsymbol"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Finder’da %@, standart belge simgesiyle"
          }
        }
      }
    },
    "%@ is a detached header: its image data is in a separate file that wasn’t passed to the shortcut. Pass the header as a file from Finder, with its data file next to it, or use a single-file format such as .nii.gz, .nrrd or .mha." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ ist ein separater Header: Die Bilddaten liegen in einer eigenen Datei, die nicht an den Kurzbefehl übergeben wurde. Übergeben Sie den Header als Datei aus dem Finder, mit der Datendatei im selben Ordner, oder verwenden Sie ein Einzeldateiformat wie .nii.gz, .nrrd oder .mha."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ ayrık bir başlık dosyasıdır: görüntü verisi, kestirmeye aktarılmayan ayrı bir dosyadadır. Başlığı, veri dosyası aynı klasörde olacak şekilde Finder’dan dosya olarak aktarın veya .nii.gz, .nrrd ya da .mha gibi tek dosyalı bir biçim kullanın."
          }
        }
      }
    },
    "%@ is not a supported volume. MIQ reads .nii, .nii.gz, .mgh, .mgz, .mif, .mif.gz, .mih, .nrrd, .nhdr, .mha and .mhd files." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ ist kein unterstütztes Volumen. MIQ liest Dateien vom Typ .nii, .nii.gz, .mgh, .mgz, .mif, .mif.gz, .mih, .nrrd, .nhdr, .mha und .mhd."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ desteklenen bir hacim değil. MIQ .nii, .nii.gz, .mgh, .mgz, .mif, .mif.gz, .mih, .nrrd, .nhdr, .mha ve .mhd dosyalarını okur."
          }
        }
      }
    },
    "%@ mL (%@ voxels)" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ ml (%@ Voxel)"
