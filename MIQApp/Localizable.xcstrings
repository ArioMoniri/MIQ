    "A NIfTI, MGH/MGZ, MIF or NRRD file." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eine NIfTI-, MGH/MGZ-, MIF- oder NRRD-Datei."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bir NIfTI, MGH/MGZ, MIF veya NRRD dosyası."
          }
