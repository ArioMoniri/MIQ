    "Copies a Terminal command that resets the Quick Look thumbnail cache. MIQ can’t run it itself from its sandbox." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kopiert einen Terminal-Befehl, der den Quick-Look-Miniatur-Cache zurücksetzt. MIQ kann ihn aus seiner Sandbox heraus nicht selbst ausführen."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quick Look küçük resim önbelleğini sıfırlayan bir Terminal komutunu kopyalar. MIQ bunu kendi korumalı alanından (sandbox) çalıştıramaz."
          }
        }
      }
    },
    "Copies orientation, segmentation colours and intensity window from the Preview pane." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Übernimmt Ausrichtung, Segmentierungsfarben und Intensitätsfenster aus dem Bereich „Vorschau“."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yönelimi, segmentasyon renklerini ve yoğunluk penceresini Önizleme bölmesinden kopyalar."
