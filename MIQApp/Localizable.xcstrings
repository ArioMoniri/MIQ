    "By hiding the disclaimer in previews, you confirm that you understand and accept these terms." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Indem Sie den Haftungsausschluss in Vorschauen ausblenden, bestätigen Sie, dass Sie diese Bedingungen verstehen und akzeptieren."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Önizlemelerde sorumluluk reddini gizleyerek bu koşulları anladığınızı ve kabul ettiğinizi onaylarsınız."
          }
        }
      }
    },
