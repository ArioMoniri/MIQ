    "Renders the centre slice of a medical volume (NIfTI, MGH/MGZ, MRtrix MIF or NRRD) in the chosen plane and returns it as a PNG image." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rendert die zentrale Schicht eines medizinischen Volumens (NIfTI, MGH/MGZ, MRtrix MIF oder NRRD) in der gewählten Ebene und gibt sie als PNG-Bild zurück."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tıbbi bir hacmin (NIfTI, MGH/MGZ, MRtrix MIF veya NRRD) orta kesitini seçilen düzlemde oluşturur ve PNG görüntüsü olarak döndürür."
          }
        }
      }
    },
    "Repetition time (TR)" : {
