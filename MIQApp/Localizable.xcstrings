    "Choose a structural brain scan to mask, or a folder holding a DICOM series." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wählen Sie einen strukturellen Hirnscan zum Maskieren oder einen Ordner mit einer DICOM-Serie."
          }
        },
        "tr" : {
