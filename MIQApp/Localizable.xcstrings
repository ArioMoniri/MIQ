          "stringUnit" : {
            "state" : "translated",
            "value" : "Görüntüyü beyne göre pencerele"
          }
        }
      }
    },
    "Window from the head only" : {
      "comment" : "Settings › Preview toggle",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fenster nur aus dem Kopf"
          }
        },
        "tr" : {
          "stringUnit" : {
