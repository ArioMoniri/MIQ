      }
    },
    "A star on GitHub helps others discover it." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein Stern auf GitHub hilft anderen, es zu entdecken."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "GitHub’da bir yıldız, başkalarının da keşfetmesine yardımcı olur."
          }
        }
      }
    },
    "Accurate" : {
      "comment" : "Brain mask model choice",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Genau"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hassas"
          }
        }
      }
    },
    "Acknowledgements" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Danksagungen"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Teşekkürler"
          }
        }
      }
    },
    "Adds a few rows to the metadata panel: the likely sequence, head-mask coverage, a defacing check and data sanity checks. Computed on this Mac from the image alone; a hint, not an assessment." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fügt dem Metadatenbereich einige Zeilen hinzu: die wahrscheinliche Sequenz, die Abdeckung der Kopfmaske, eine Defacing-Prüfung und Plausibilitätsprüfungen der Daten. Allein aus dem Bild auf diesem Mac berechnet; ein Hinweis, keine Beurteilung."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Meta veri paneline birkaç satır ekler: olası sekans, kafa maskesi kapsamı, yüz silme (defacing) denetimi ve veri tutarlılığı denetimleri. Yalnızca görüntüden, bu Mac’te hesaplanır; bir ipucudur, değerlendirme değildir."
          }
        }
      }
    },
    "Adds an Open in button to MIQ’s file windows. Only installed viewers are listed." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fügt den Dateifenstern von MIQ eine Taste „Öffnen in“ hinzu. Nur installierte Viewer werden aufgeführt."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MIQ’nun dosya pencerelerine bir Şununla Aç düğmesi ekler. Yalnızca yüklü görüntüleyiciler listelenir."
          }
        }
      }
    },
    "Adjust brightness & contrast" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Helligkeit & Kontrast anpassen"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Parlaklık ve kontrastı ayarla"
          }
        }
      }
    },
    "An administrator set this with a configuration profile, so it can’t be changed here." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eine Administratorin oder ein Administrator hat dies mit einem Konfigurationsprofil festgelegt; es kann hier nicht geändert werden."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bir yönetici bunu bir yapılandırma profiliyle ayarladı; burada değiştirilemez."
          }
        }
      }
    },
    "Appearance" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Darstellung"
          }
