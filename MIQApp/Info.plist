<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleDisplayName</key>
	<string>MIQ</string>
	<!-- Lists MIQ under Finder's "Open With" without ever taking over a format's
	     default app (Alternate rank). The app shows the file in a Quick Look
	     window, so the MIQ preview extension does the rendering. The gzip entry is
	     needed for .nii.gz/.mgh.gz/.mif.gz (see UTImportedTypeDeclarations below);
	     the app declines a .gz that MIQFileKind doesn't recognise. -->
	<key>CFBundleDocumentTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeName</key>
			<string>Medical Image Volume</string>
			<key>CFBundleTypeRole</key>
			<string>Viewer</string>
			<key>LSHandlerRank</key>
			<string>Alternate</string>
			<key>LSItemContentTypes</key>
			<array>
				<string>org.nifti.nii</string>
				<string>gov.nih.nifti-1</string>
				<string>org.nifti.nii-gz</string>
				<string>org.freesurfer.mgh</string>
				<string>org.freesurfer.mgz</string>
				<string>org.mrtrix.mif</string>
				<string>org.mrtrix.mif-gz</string>
				<string>org.teem.nrrd</string>
				<string>org.teem.nhdr</string>
				<string>org.mrtrix.mih</string>
				<string>org.itk.metaimage</string>
				<string>org.itk.metaimage-header</string>
				<string>org.nema.dicom</string>
			</array>
		</dict>
		<dict>
			<key>CFBundleTypeName</key>
			<string>Zarr Image Store</string>
			<key>CFBundleTypeRole</key>
			<string>Viewer</string>
			<key>LSHandlerRank</key>
			<string>Alternate</string>
			<key>LSTypeIsPackage</key>
			<true/>
			<key>LSItemContentTypes</key>
			<array>
				<string>dev.zarr.zarr</string>
			</array>
		</dict>
		<dict>
			<key>CFBundleTypeName</key>
			<string>Compressed Medical Image Volume</string>
			<key>CFBundleTypeRole</key>
			<string>Viewer</string>
			<key>LSHandlerRank</key>
			<string>Alternate</string>
			<key>LSItemContentTypes</key>
			<array>
				<string>public.gzip</string>
				<string>org.gnu.gnu-zip-archive</string>
			</array>
		</dict>
	</array>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>LSMinimumSystemVersion</key>
	<string>14.0</string>
	<key>MIQAppGroupID</key>
	<string>$(APP_GROUP_ID)</string>
	<key>NSHumanReadableCopyright</key>
	<string>Licensed under the MIT License</string>
	<key>NSQuitAlwaysKeepsWindows</key>
	<false/>
	<key>SUEnableAutomaticChecks</key>
	<true/>
	<key>SUEnableInstallerLauncherService</key>
	<true/>
	<key>SUFeedURL</key>
	<string>https://miq.marco-duering.net/appcast.xml</string>
	<key>SUPublicEDKey</key>
	<string>zMEpcrCUdLsdNOGJkcIeuJtolubF25q1savnb+nk1To=</string>
	<!-- Imported (not exported): MIQ does not own these formats, it only reads them.
	     Launch Services matches a file to a type by its LAST path extension only, so
	     a two-part tag such as "nii.gz" never matches: Finder resolves x.nii.gz to the
	     system gzip type (org.gnu.gnu-zip-archive). Compressed volumes therefore reach
	     MIQ through the extensions' gzip claims plus the MIQFileKind filename check,
	     not through the declarations below. Only types whose bytes are gzip conform
	     to public.gzip; MIME tags stay format-specific (application/gzip would map
	     every gzip download to a MIQ type). -->
	<key>UTImportedTypeDeclarations</key>
	<array>
		<dict>
			<key>UTTypeConformsTo</key>
			<array>
				<string>public.data</string>
			</array>
			<key>UTTypeDescription</key>
			<string>NIfTI-1 Image</string>
			<key>UTTypeIdentifier</key>
			<string>org.nifti.nii</string>
			<key>UTTypeTagSpecification</key>
			<dict>
				<key>public.filename-extension</key>
				<array>
					<string>nii</string>
				</array>
				<key>public.mime-type</key>
				<array>
					<string>application/x-nifti</string>
				</array>
			</dict>
		</dict>
		<!-- The identifier other NIfTI apps (e.g. NIfTIViewQL) export for .nii; when one
		     is installed, .nii may resolve here instead of to org.nifti.nii, which is
		     why both extensions claim it. Declared without tags so MIQ never competes
		     with org.nifti.nii for "nii"; it only guarantees the type exists and
		     conforms to public.data when no exporting app is installed. -->
		<dict>
			<key>UTTypeConformsTo</key>
			<array>
				<string>public.data</string>
			</array>
			<key>UTTypeDescription</key>
			<string>NIfTI-1 Image</string>
			<key>UTTypeIdentifier</key>
			<string>gov.nih.nifti-1</string>
		</dict>
		<!-- No tags (only "nii.gz" would fit, which Launch Services never matches). Kept
		     because the extensions claim it: it documents intent and lets MIQ preview
		     data that an app or pasteboard explicitly types as org.nifti.nii-gz. -->
		<dict>
			<key>UTTypeConformsTo</key>
			<array>
				<string>public.data</string>
				<string>public.gzip</string>
			</array>
			<key>UTTypeDescription</key>
			<string>Gzipped NIfTI-1 Image</string>
			<key>UTTypeIdentifier</key>
			<string>org.nifti.nii-gz</string>
		</dict>
		<dict>
			<key>UTTypeConformsTo</key>
			<array>
				<string>public.data</string>
			</array>
			<key>UTTypeDescription</key>
			<string>FreeSurfer MGH Volume</string>
			<key>UTTypeIdentifier</key>
			<string>org.freesurfer.mgh</string>
			<key>UTTypeTagSpecification</key>
			<dict>
				<key>public.filename-extension</key>
				<array>
					<string>mgh</string>
				</array>
				<key>public.mime-type</key>
				<array>
					<string>application/x-mgh</string>
				</array>
			</dict>
		</dict>
		<!-- .mgh.gz is the same format but, like .nii.gz, resolves to the system gzip
		     type; MIQFileKind maps it to .mgz. -->
		<dict>
			<key>UTTypeConformsTo</key>
			<array>
				<string>public.data</string>
				<string>public.gzip</string>
			</array>
			<key>UTTypeDescription</key>
			<string>FreeSurfer MGZ Volume</string>
			<key>UTTypeIdentifier</key>
			<string>org.freesurfer.mgz</string>
			<key>UTTypeTagSpecification</key>
			<dict>
				<key>public.filename-extension</key>
				<array>
					<string>mgz</string>
				</array>
			</dict>
		</dict>
		<dict>
			<key>UTTypeConformsTo</key>
			<array>
				<string>public.data</string>
			</array>
			<key>UTTypeDescription</key>
			<string>MRtrix Image Format</string>
			<key>UTTypeIdentifier</key>
			<string>org.mrtrix.mif</string>
			<key>UTTypeTagSpecification</key>
			<dict>
				<key>public.filename-extension</key>
				<array>
					<string>mif</string>
				</array>
				<key>public.mime-type</key>
				<array>
					<string>application/x-mrtrix</string>
				</array>
			</dict>
		</dict>
		<!-- No tags, for the same reason as org.nifti.nii-gz. -->
		<dict>
			<key>UTTypeConformsTo</key>
			<array>
				<string>public.data</string>
				<string>public.gzip</string>
			</array>
			<key>UTTypeDescription</key>
			<string>Compressed MRtrix Image Format</string>
			<key>UTTypeIdentifier</key>
			<string>org.mrtrix.mif-gz</string>
		</dict>
		<!-- Not gzip-conformant: a .nrrd payload may be raw or gzip, and the header,
		     not the extension, says which. -->
		<dict>
			<key>UTTypeConformsTo</key>
			<array>
				<string>public.data</string>
			</array>
			<key>UTTypeDescription</key>
			<string>Nearly Raw Raster Data</string>
			<key>UTTypeIdentifier</key>
			<string>org.teem.nrrd</string>
			<key>UTTypeTagSpecification</key>
			<dict>
				<key>public.filename-extension</key>
				<array>
					<string>nrrd</string>
				</array>
				<key>public.mime-type</key>
				<array>
					<string>application/x-nrrd</string>
				</array>
			</dict>
		</dict>
		<!-- Detached NRRD header: a text-only header whose data file field names the payload next to it. The Quick Look sandbox may grant only the header itself; see README troubleshooting. -->
		<dict>
			<key>UTTypeConformsTo</key>
			<array>
				<string>public.data</string>
			</array>
			<key>UTTypeDescription</key>
			<string>NRRD Detached Header</string>
			<key>UTTypeIdentifier</key>
			<string>org.teem.nhdr</string>
			<key>UTTypeReferenceURL</key>
			<string>https://teem.sourceforge.net/nrrd/format.html</string>
			<key>UTTypeTagSpecification</key>
			<dict>
				<key>public.filename-extension</key>
				<array>
					<string>nhdr</string>
				</array>
			</dict>
		</dict>
		<!-- MRtrix detached header (file: name offset points at the payload). -->
		<dict>
			<key>UTTypeConformsTo</key>
			<array>
				<string>public.data</string>
			</array>
			<key>UTTypeDescription</key>
			<string>MRtrix Image Header</string>
			<key>UTTypeIdentifier</key>
			<string>org.mrtrix.mih</string>
			<key>UTTypeReferenceURL</key>
			<string>https://mrtrix.readthedocs.io/en/latest/getting_started/image_data.html</string>
			<key>UTTypeTagSpecification</key>
			<dict>
				<key>public.filename-extension</key>
				<array>
					<string>mih</string>
				</array>
			</dict>
		</dict>
		<!-- ITK MetaImage with an attached payload (ElementDataFile = LOCAL). -->
		<dict>
			<key>UTTypeConformsTo</key>
			<array>
				<string>public.data</string>
			</array>
			<key>UTTypeDescription</key>
			<string>MetaImage</string>
			<key>UTTypeIdentifier</key>
			<string>org.itk.metaimage</string>
			<key>UTTypeReferenceURL</key>
			<string>https://itk.org/Wiki/ITK/MetaIO/Documentation</string>
			<key>UTTypeTagSpecification</key>
			<dict>
				<key>public.filename-extension</key>
				<array>
					<string>mha</string>
				</array>
			</dict>
		</dict>
		<!-- ITK MetaImage detached header (ElementDataFile names the payload). -->
		<dict>
			<key>UTTypeConformsTo</key>
			<array>
				<string>public.data</string>
			</array>
			<key>UTTypeDescription</key>
			<string>MetaImage Header</string>
			<key>UTTypeIdentifier</key>
			<string>org.itk.metaimage-header</string>
			<key>UTTypeReferenceURL</key>
			<string>https://itk.org/Wiki/ITK/MetaIO/Documentation</string>
			<key>UTTypeTagSpecification</key>
			<dict>
				<key>public.filename-extension</key>
				<array>
					<string>mhd</string>
				</array>
			</dict>
		</dict>
		<!-- DICOM Part-10. Imported, not exported: MIQ doesn't own the format. Only
		     files with a .dcm/.dicom extension reach Quick Look; extensionless
		     DICOM gets public.data. See CONTRIBUTING.md, "DICOM and Zarr plist wiring". -->
		<dict>
			<key>UTTypeConformsTo</key>
			<array>
				<string>public.data</string>
				<string>public.image</string>
			</array>
			<key>UTTypeDescription</key>
			<string>DICOM Image</string>
			<key>UTTypeIdentifier</key>
			<string>org.nema.dicom</string>
			<key>UTTypeReferenceURL</key>
			<string>https://www.dicomstandard.org/current</string>
			<key>UTTypeTagSpecification</key>
			<dict>
				<key>public.filename-extension</key>
				<array>
					<string>dcm</string>
					<string>dicom</string>
				</array>
				<key>public.mime-type</key>
				<array>
					<string>application/dicom</string>
				</array>
			</dict>
		</dict>
		<!-- Zarr store (OME-Zarr / NIfTI-Zarr). Quick Look only hands a directory to
		     an extension when its UTI is a package, so Finder shows *.zarr folders
		     as single items while MIQ is installed (Show Package Contents opens
		     them). See CONTRIBUTING.md, "DICOM and Zarr plist wiring". -->
		<dict>
			<key>UTTypeConformsTo</key>
			<array>
				<string>com.apple.package</string>
				<string>public.directory</string>
			</array>
			<key>UTTypeDescription</key>
			<string>Zarr Image Store</string>
			<key>UTTypeIdentifier</key>
			<string>dev.zarr.zarr</string>
			<key>UTTypeTagSpecification</key>
			<dict>
				<key>public.filename-extension</key>
				<array>
					<string>zarr</string>
				</array>
			</dict>
		</dict>
	</array>
</dict>
</plist>
