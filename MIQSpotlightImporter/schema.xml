                org_miq_datatype
                org_miq_volumes
                org_miq_orientation
            </displayattrs>
        </type>
        <type name="org.mrtrix.mif-gz">
            <note>Compressed MRtrix MIF volume</note>
            <allattrs>
                kMDItemPixelWidth
                kMDItemPixelHeight
                org_miq_dimensions
                org_miq_voxelSpacing
                org_miq_spacingUnit
                org_miq_datatype
                org_miq_volumes
                org_miq_orientation
            </allattrs>
            <displayattrs>
                org_miq_dimensions
                org_miq_voxelSpacing
                org_miq_datatype
                org_miq_volumes
                org_miq_orientation
            </displayattrs>
        </type>
        <type name="org.teem.nrrd">
            <note>NRRD volume</note>
            <allattrs>
                kMDItemPixelWidth
                kMDItemPixelHeight
                org_miq_dimensions
                org_miq_voxelSpacing
                org_miq_spacingUnit
                org_miq_datatype
                org_miq_volumes
                org_miq_orientation
            </allattrs>
            <displayattrs>
                org_miq_dimensions
                org_miq_voxelSpacing
                org_miq_datatype
                org_miq_volumes
                org_miq_orientation
            </displayattrs>
        </type>
    </types>
</schema>
